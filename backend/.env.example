# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI-Compatible API Configuration
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-actual-api-key-here
OPENAI_MODEL_NAME=deepseek-chat

# Transformation tuning (optional)
# One provider call per request is the default: MAX_CHUNK_CHARS matches the API
# input cap (50,000 chars), so documents are never fanned out into parallel calls.
MAX_CHUNK_CHARS=50000
# Output token ceiling. Prevents mid-JSON truncation (the main cause of
# "unparseable JSON" responses) and of the repair pass ever being needed.
LLM_MAX_TOKENS=8192
# Thinking mode adds a chain-of-thought pass we never consume (~50s per call).
# auto = disabled for DeepSeek hosts, omitted elsewhere; 1 = always disable;
# 0 = never send the parameter (use for providers that reject unknown fields).
LLM_DISABLE_THINKING=auto
# Retry attempts for transient provider failures (429/503/timeouts only).
LLM_MAX_RETRIES=3
# Opt-in second call that repairs malformed JSON. Leave at 0 to guarantee a
# single provider call per request (malformed output then returns HTTP 502).
LLM_JSON_REPAIR_PASS=0
# Only relevant if you deliberately lower MAX_CHUNK_CHARS below 50,000.
LLM_MAX_CONCURRENCY=3
